{
  "title": "Care transition agent",
  "uid": "cta-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "cta"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Identifiers blocked before a provider (24 h)",
      "description": "Requests refused because a known identifier survived pseudonymisation. Should be rare; each one is a replacer miss.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cta_gateway_leaks_blocked_total[24h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Requests refused by processor policy (24 h)",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cta_gateway_policy_denied_total[24h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Profiles released (24 h)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cta_releases_total[24h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Accepted without change (grounded values, 24 h)",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cta_review_actions_total{action=\"accepted\",agent_status=\"grounded\"}[24h])) / clamp_min(sum(increase(cta_review_actions_total{agent_status=\"grounded\"}[24h])),1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Agent runs by outcome",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workflow, status) (rate(cta_agent_runs_total[5m]))",
          "legendFormat": "{{workflow}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run duration p50 / p95",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(cta_agent_run_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cta_agent_run_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens by model",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (rate(cta_agent_tokens_total[5m]))",
          "legendFormat": "{{model}} {{direction}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Verifier verdicts by field status",
      "description": "A rise in conflict or unsupported after a prompt change is the first sign of a worse drafter.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(cta_field_verdicts_total[15m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Review actions on grounded vs flagged values",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action, agent_status) (rate(cta_review_actions_total[1h]))",
          "legendFormat": "{{agent_status}} {{action}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Guardrail events",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(cta_guardrail_events_total[15m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Gateway: identifiers replaced by kind",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(cta_gateway_pseudonymized_total[15m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Gateway: retries and latency by processor",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cta_gateway_upstream_attempts_total[5m])) / clamp_min(sum(rate(cta_gateway_requests_total[5m])),1e-9)",
          "legendFormat": "attempts per request"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, upstream) (rate(cta_gateway_request_seconds_bucket[5m])))",
          "legendFormat": "p95 seconds {{upstream}}"
        }
      ]
    }
  ]
}